{
  "code": {
    "gate": [
      {"name": "lint", "cmd": ["bash", "-c", "git diff --name-only --diff-filter=ACM HEAD -- '*.php' | xargs -r -n1 php -l"]},
      {"name": "test-scoping", "cmd": ["php", "tests/unit/test-scoping.php"]}
    ],
    "stage": {"label": "code", "paths": ["src", "public", "tests", "composer.json", "composer.lock"]}
  }
}
